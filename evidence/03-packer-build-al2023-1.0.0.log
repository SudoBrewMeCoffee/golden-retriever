==> al2023-cis-base.proxmox-clone.al2023:             "# Log all the mail messages in one place.",
==> al2023-cis-base.proxmox-clone.al2023:             "mail.*                                                  -/var/log/maillog",
==> al2023-cis-base.proxmox-clone.al2023:             "",
==> al2023-cis-base.proxmox-clone.al2023:             "",
